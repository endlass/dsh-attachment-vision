{
  "name": "dsh-attachment-vision",
  "version": "0.1.0",
  "description": "Give text-only DeepSeek models eyes: GUI image attachments are auto-transcribed to attachment paths, plus a view_image bridge to any OpenAI-compatible VLM.",
  "keywords": [
    "deepseek",
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "vision",
    "vlm",
    "image",
    "attachment"
  ],
  "license": "MIT",
  "type": "commonjs",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "examples",
    "scripts"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "check": "node --check lib/index.js",
    "verify": "bash scripts/verify.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TO-BE-PUBLISHED/dsh-attachment-vision.git"
  }
}
